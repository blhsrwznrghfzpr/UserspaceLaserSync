<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ResoniteProjectType>tests</ResoniteProjectType>
    <AssemblyName>UserspaceLaserSync.Tests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" Condition="'$(UseHarmonyX)' != 'true'" />
    <PackageReference Include="HarmonyX" Version="2.16.0" Condition="'$(UseHarmonyX)' == 'true'" />
  </ItemGroup>
</Project>
